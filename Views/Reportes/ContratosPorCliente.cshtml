@model ReporteContratosViewModel
@{ ViewData["Title"] = "Reporte de contratos"; }
<section class="encabezado-pagina no-imprimir"><div><span class="sobrelinea">REPORTES</span><h1>Contratos por cliente</h1><p>Consulte el historial y los valores financieros.</p></div><button class="boton primario" type="button" onclick="window.print()">▥ Imprimir reporte</button></section>
<section class="tarjeta no-imprimir"><form method="get" class="barra-filtros"><div class="campo filtro-cliente"><label>Cliente</label><select name="clienteId"><option value="">Todos los clientes</option>@foreach (var cliente in Model.Clientes){if(Model.ClienteId == cliente.Id){<option value="@cliente.Id" selected>@cliente.Cedula · @cliente.NombreCompleto</option>}else{<option value="@cliente.Id">@cliente.Cedula · @cliente.NombreCompleto</option>}}</select></div><button class="boton primario" type="submit">Generar</button>@if(Model.ClienteId.HasValue){<a class="boton texto" asp-action="ContratosPorCliente">Limpiar</a>}</form></section>
<section class="reporte tarjeta">
    <header class="reporte-cabecera"><div><span class="marca-icono">A</span><div><h2>AutoControl</h2><p>Sistema de Control de Alquiler de Autos</p></div></div><div><strong>REPORTE DE CONTRATOS</strong><small>Generado: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</small></div></header>
    <div class="resumen-reporte"><div><small>CONTRATOS</small><strong>@Model.Contratos.Count</strong></div><div><small>TOTAL CONTRATADO</small><strong>$@Model.TotalContratado.ToString("N2")</strong></div><div><small>TOTAL PAGADO</small><strong>$@Model.TotalPagado.ToString("N2")</strong></div><div><small>SALDO PENDIENTE</small><strong>$@Model.SaldoPendiente.ToString("N2")</strong></div></div>
    <div class="tabla-contenedor"><table><thead><tr><th>N.º</th><th>Cliente</th><th>Vehículo</th><th>Periodo</th><th>Total</th><th>Pagado</th><th>Saldo</th><th>Estado</th></tr></thead><tbody>@foreach(var item in Model.Contratos){<tr><td>#@item.Id.ToString("0000")</td><td><strong>@item.Cliente?.NombreCompleto</strong><small>@item.Cliente?.Cedula</small></td><td><strong>@item.Vehiculo?.Marca @item.Vehiculo?.Modelo</strong><small>@item.Vehiculo?.Placa</small></td><td>@item.FechaInicio.ToString("dd/MM/yy") – @item.FechaFin.ToString("dd/MM/yy")</td><td>$@item.Total.ToString("N2")</td><td>$@item.TotalPagado.ToString("N2")</td><td>$@item.SaldoPendiente.ToString("N2")</td><td><span class="etiqueta @item.Estado.ToString().ToLowerInvariant()">@item.Estado</span></td></tr>}</tbody></table></div>
    @if(!Model.Contratos.Any()){<div class="estado-vacio compacto"><span>▥</span><p>No existen contratos para el criterio seleccionado.</p></div>}
    <footer class="reporte-pie">Documento informativo generado por AutoControl.</footer>
</section>
