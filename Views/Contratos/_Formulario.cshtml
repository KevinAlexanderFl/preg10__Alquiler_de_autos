@model Contrato
<div asp-validation-summary="ModelOnly" class="validacion-resumen"></div>
<div class="formulario-cuadricula">
    <div class="campo ancho-completo"><label asp-for="ClienteId"></label><select asp-for="ClienteId" asp-items="ViewBag.ClienteId"><option value="">Seleccione un cliente</option></select><span asp-validation-for="ClienteId"></span></div>
    <div class="campo ancho-completo"><label asp-for="VehiculoId"></label><select asp-for="VehiculoId" asp-items="ViewBag.VehiculoId" id="selectorVehiculo"><option value="">Seleccione un vehículo</option></select><span asp-validation-for="VehiculoId"></span></div>
    <div class="campo"><label asp-for="FechaInicio"></label><input asp-for="FechaInicio" asp-format="{0:yyyy-MM-dd}" type="date" id="fechaInicio" /><span asp-validation-for="FechaInicio"></span></div>
    <div class="campo"><label asp-for="FechaFin"></label><input asp-for="FechaFin" asp-format="{0:yyyy-MM-dd}" type="date" id="fechaFin" /><span asp-validation-for="FechaFin"></span></div>
    <div class="campo"><label asp-for="TarifaDiaria"></label><div class="entrada-prefijo"><span>$</span><input asp-for="TarifaDiaria" type="number" min="0.01" step="0.01" id="tarifaDiaria" /></div><span asp-validation-for="TarifaDiaria"></span></div>
    <div class="resumen-total"><small>TOTAL ESTIMADO</small><strong id="totalEstimado">$@Model.Total.ToString("N2")</strong><span id="diasAlquiler">La tarifa se calcula por día.</span></div>
    <div class="campo ancho-completo"><label asp-for="Observaciones"></label><textarea asp-for="Observaciones" rows="3" placeholder="Condiciones o comentarios adicionales"></textarea><span asp-validation-for="Observaciones"></span></div>
</div>
