@model Contrato
@{ ViewData["Title"] = "Editar contrato"; }
<section class="encabezado-pagina"><div><a class="volver" asp-action="Index">← Volver a contratos</a><h1>Editar contrato #@Model.Id.ToString("0000")</h1><p>Ajuste los datos antes de finalizar el alquiler.</p></div></section>
<form asp-action="Editar" asp-route-id="@Model.Id" class="tarjeta formulario-tarjeta" method="post">
    <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="Estado" />
    <div class="seccion-titulo"><span>✎</span><div><h2>Datos del alquiler</h2><p>Los cruces de fechas se verificarán nuevamente.</p></div></div>
    <partial name="_Formulario" model="Model" />
    <div class="formulario-acciones"><a class="boton secundario" asp-action="Index">Cancelar</a><button class="boton primario" type="submit">Guardar cambios</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/contratos.js" asp-append-version="true"></script> }
