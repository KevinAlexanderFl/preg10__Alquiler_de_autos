@model Contrato
@{ ViewData["Title"] = "Nuevo contrato"; }
<section class="encabezado-pagina"><div><a class="volver" asp-action="Index">← Volver a contratos</a><h1>Crear contrato de alquiler</h1><p>Seleccione el cliente, el vehículo y el periodo solicitado.</p></div></section>
<form asp-action="Crear" class="tarjeta formulario-tarjeta" method="post">
    <div class="seccion-titulo"><span>01</span><div><h2>Datos del alquiler</h2><p>El sistema validará automáticamente la disponibilidad.</p></div></div>
    <partial name="_Formulario" model="Model" />
    <div class="formulario-acciones"><a class="boton secundario" asp-action="Index">Cancelar</a><button class="boton primario" type="submit">Crear contrato</button></div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/contratos.js" asp-append-version="true"></script> }
