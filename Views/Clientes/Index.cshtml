@model IEnumerable<Cliente>
@{
    ViewData["Title"] = "Clientes";
}
<section class="encabezado-pagina">
    <div><span class="sobrelinea">ADMINISTRACIÓN</span><h1>Clientes</h1><p>Información y estado de las personas registradas.</p></div>
    <a class="boton primario" asp-action="Crear">＋ Nuevo cliente</a>
</section>
<section class="tarjeta">
    <form method="get" class="barra-filtros">
        <label class="buscador"><span>⌕</span><input name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por cédula, nombre o correo..." /></label>
        <button class="boton secundario" type="submit">Buscar</button>
        @if (ViewBag.Buscar is not null) { <a class="boton texto" asp-action="Index">Limpiar</a> }
    </form>
    <div class="tabla-contenedor">
        <table>
            <thead><tr><th>Cliente</th><th>Cédula</th><th>Contacto</th><th>Estado</th><th class="acciones-columna">Acciones</th></tr></thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><div class="persona"><span>@item.Nombres.FirstOrDefault()@item.Apellidos.FirstOrDefault()</span><div><strong>@item.NombreCompleto</strong><small>@item.Correo</small></div></div></td>
                    <td>@item.Cedula</td>
                    <td><strong>@item.Telefono</strong><small>@(item.Direccion ?? "Sin dirección")</small></td>
                    <td><span class="etiqueta @(item.Activo ? "disponible" : "cancelado")">@(item.Activo ? "Activo" : "Inactivo")</span></td>
                    <td class="acciones">
                        <a title="Ver" asp-action="Detalles" asp-route-id="@item.Id">⌕</a>
                        <a title="Editar" asp-action="Editar" asp-route-id="@item.Id">✎</a>
                        <a class="peligro" title="Eliminar" asp-action="Eliminar" asp-route-id="@item.Id">♲</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    @if (!Model.Any()) { <div class="estado-vacio compacto"><span>♙</span><p>No se encontraron clientes.</p></div> }
</section>
