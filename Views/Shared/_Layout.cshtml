@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Inicio";
    string Activo(string nombre) => controlador == nombre ? "activo" : string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sistema de control de alquiler de autos" />
    <title>@ViewData["Title"] · AutoControl</title>
    <link rel="stylesheet" href="~/css/estilos.css" asp-append-version="true" />
</head>
<body>
    <aside class="barra-lateral" id="barraLateral">
        <a class="marca" asp-controller="Inicio" asp-action="Index">
            <span class="marca-icono">A</span>
            <span><strong>AutoControl</strong><small>Gestión de alquileres</small></span>
        </a>
        <nav class="menu">
            <span class="menu-titulo">MENÚ PRINCIPAL</span>
            <a class="@Activo("Inicio")" asp-controller="Inicio" asp-action="Index"><span>⌂</span> Panel principal</a>
            <a class="@Activo("Clientes")" asp-controller="Clientes" asp-action="Index"><span>♙</span> Clientes</a>
            <a class="@Activo("Vehiculos")" asp-controller="Vehiculos" asp-action="Index"><span>◆</span> Vehículos</a>
            <a class="@Activo("Contratos")" asp-controller="Contratos" asp-action="Index"><span>▤</span> Contratos</a>
            <a class="@Activo("Pagos")" asp-controller="Pagos" asp-action="Index"><span>$</span> Pagos</a>
            <span class="menu-titulo">ANÁLISIS</span>
            <a class="@Activo("Reportes")" asp-controller="Reportes" asp-action="ContratosPorCliente"><span>▥</span> Reportes</a>
        </nav>
        <div class="barra-pie">
            <span class="estado-punto"></span>
            <div><strong>Sistema operativo</strong><small>Conexión local</small></div>
        </div>
    </aside>

    <div class="aplicacion">
        <header class="cabecera">
            <button type="button" class="boton-menu" id="botonMenu" aria-label="Abrir menú">☰</button>
            <div class="cabecera-titulo">
                <strong>@ViewData["Title"]</strong>
                <span>@DateTime.Now.ToString("dddd, dd 'de' MMMM", new System.Globalization.CultureInfo("es-EC"))</span>
            </div>
            <div class="usuario">
                <span class="avatar">AD</span>
                <div><strong>Administrador</strong><small>Control total</small></div>
            </div>
        </header>

        <main class="contenido">
            @if (TempData["Exito"] is string exito)
            {
                <div class="alerta exito" role="alert"><span>✓</span><div>@exito</div><button type="button">×</button></div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alerta error" role="alert"><span>!</span><div>@error</div><button type="button">×</button></div>
            }
            @RenderBody()
        </main>
        <footer>AutoControl © @DateTime.Now.Year · Sistema de Control de Alquiler de Autos</footer>
    </div>
    <div class="fondo-menu" id="fondoMenu"></div>
    <script src="~/js/aplicacion.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
