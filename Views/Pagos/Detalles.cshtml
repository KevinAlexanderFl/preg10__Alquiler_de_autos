@model Pago
@{ ViewData["Title"] = "Detalle del pago"; }
<section class="encabezado-pagina"><div><a class="volver" asp-action="Index">← Volver a pagos</a><h1>Pago #P-@Model.Id.ToString("0000")</h1><p>Comprobante del movimiento registrado.</p></div><a class="boton primario" asp-action="Editar" asp-route-id="@Model.Id">✎ Editar</a></section>
<section class="tarjeta detalle-tarjeta comprobante"><div class="comprobante-cabecera"><div><span class="marca-icono">A</span><strong>AutoControl</strong></div><span class="etiqueta @Model.Estado.ToString().ToLowerInvariant()">@Model.Estado</span></div><div class="monto-comprobante"><small>MONTO REGISTRADO</small><strong>$@Model.Monto.ToString("N2")</strong></div><div class="detalle-cuadricula"><div><small>CONTRATO</small><strong><a asp-controller="Contratos" asp-action="Detalles" asp-route-id="@Model.ContratoId">#@Model.ContratoId.ToString("0000")</a></strong></div><div><small>CLIENTE</small><strong>@Model.Contrato?.Cliente?.NombreCompleto</strong></div><div><small>FECHA</small><strong>@Model.FechaPago.ToString("dd/MM/yyyy")</strong></div><div><small>MÉTODO</small><strong>@Model.Metodo</strong></div><div><small>REFERENCIA</small><strong>@(Model.NumeroReferencia ?? "No aplica")</strong></div></div></section>
